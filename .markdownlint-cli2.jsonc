{
  // Only our custom rule is enabled: it catches headings glued to a
  // preceding line with no blank line in between, which can fail to
  // render on the live site. It carves out the one legitimate case where
  // that's expected: a heading as the first line inside a "{% hint %}"
  // block, which GitBook renders as the hint's title.
  "config": {
    "default": false,
    "heading-blank-line-above": true
  },
  "customRules": [
    "./.github/markdownlint-rules/heading-blank-line-above.js"
  ],
  "globs": [
    "docs/**/*.md"
  ]
}
